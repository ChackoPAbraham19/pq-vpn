# Certificates and keys (never commit private key material)
pki/certs/

# TLS session tickets written by `s_client -sess_out`. These are SSL SESSION
# PARAMETERS blobs — key material, not results. Two of them reached the public
# repo once via `git add -A`; this rule keeps that from recurring.
*.tick

# Benchmark raw data IS tracked: every table in docs/BENCHMARKS.md must be
# reproducible from benchmark/results/*.csv by anyone who clones the repo.

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# System files
*.swp
*.swo
*~
.DS_Store

# Runtime artifacts
/tmp/pqvpn.pid
/tmp/pqvpn.sock
/tmp/pqvpn.state

# IDE
.vscode/
.idea/

# Virtual environment
.venv/

# Graphify knowledge graph (auto-generated, not part of project)
graphify-out/

# Lock files
.~lock.*
# VPS deployment config (contains the real public IP / NIC)
server/config-vps.yaml
client/config-vps.yaml

# Stray file from a mistyped shell command (was committed-by-accident bait)
/cd
