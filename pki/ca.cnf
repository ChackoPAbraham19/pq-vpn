# `openssl ca` configuration shared by both PKIs. CERT_DIR is exported by
# pki/_env.sh (pki/certs/<mode>); the database lives under $CERT_DIR/db.
[ca]
default_ca = pqvpn

[pqvpn]
dir              = $ENV::CERT_DIR
database         = $dir/db/index.txt
serial           = $dir/db/serial
crlnumber        = $dir/db/crlnumber
new_certs_dir    = $dir/db/newcerts
certificate      = $dir/ca.crt
private_key      = $dir/ca.key
default_days     = 3650
# Matches default_days deliberately. A short CRL lifetime is a real safety
# property in production: a stale CRL may be concealing a revocation, so
# verifiers are right to refuse it. That reasoning assumes the CRL is being
# refreshed from a distribution point or OCSP. This project ships crl.pem as a
# file beside the deployment and re-reads it per session (no CDP, no OCSP — see
# docs/PROJECT_REPORT.md §15), so nothing refreshes it automatically and a short
# window buys no security. At the old 30 days the entire VPN stopped accepting
# clients one month after `gen_*_ca.sh`, with OpenSSL reporting only
# "error 12 ... CRL has expired" from inside a failed handshake.
# Refresh after any revocation with pki/refresh_crl.sh.
default_crl_days = 3650
# "default" lets the key type pick the digest: required for ML-DSA (no
# separate hash), harmless for ECDSA (sha256).
default_md       = default
unique_subject   = no
policy           = pol_client
x509_extensions  = leaf
copy_extensions  = none

[pol_client]
commonName          = supplied
countryName         = optional
stateOrProvinceName = optional
organizationName    = optional

# Leaf (client) certificate extensions.
[leaf]
basicConstraints       = CA:FALSE
keyUsage               = critical, digitalSignature
extendedKeyUsage       = clientAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid

[req]
distinguished_name = req_dn
[req_dn]
